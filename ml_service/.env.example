# ML Service Environment Variables

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
DEBUG=False

# Model Training Parameters
N_ESTIMATORS=200
MAX_DEPTH=6
LEARNING_RATE=0.1
MIN_CHILD_WEIGHT=1
SUBSAMPLE=0.8
COLSAMPLE_BYTREE=0.8

# Prediction Thresholds
BUY_THRESHOLD=0.6
SELL_THRESHOLD=0.6
MIN_CONFIDENCE=0.5

# Data Ingestion
DEFAULT_START_DATE=2020-01-01
DEFAULT_END_DATE=2024-11-14
DATA_INTERVAL=1d

# Model Versioning
MODEL_VERSION=v1
